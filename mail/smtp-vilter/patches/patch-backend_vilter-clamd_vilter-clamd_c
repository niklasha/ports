+/*
+ * Send one INSTREAM chunk: a 4 byte length in network byte order
+ * followed by the data.  A zero length chunk terminates the stream.
+ */
+static int
+instream_chunk(int fd, char *data, size_t len, struct timeval *t)
+{
+	u_int32_t	hdr;
+
+	hdr = htonl((u_int32_t)len);
+	if (to_send(fd, (char *)&hdr, sizeof(hdr), 0, t) != sizeof(hdr))
+		return -1;
+	if (len > 0 && to_send(fd, data, len, 0, t) != len)
+		return -1;
+	return 0;
+}
