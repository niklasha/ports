+/*
+ * Read from the connection, through TLS once it has been set up.
+ * Returns like read(2): >0 bytes read, 0 on EOF, -1 on error.
+ * Once br_tls is set, the socket is never read in plain text again.
+ */
+static ssize_t
+ber_sock_read(struct ber *ber, void *buf, size_t len)
+{
+	ssize_t r;
+
+	if (ber->br_tls == NULL)
+		return read(ber->fd, buf, len);
+
+	do {
+		r = tls_read(ber->br_tls, buf, len);
+	} while (r == TLS_WANT_POLLIN || r == TLS_WANT_POLLOUT);
+	if (r == -1)
+		errno = EIO;
+	return r;
+}
+
+/*
+ * Write the whole buffer to the connection, through TLS once it has
+ * been set up.  Returns len on success, -1 on error.
+ */
+static ssize_t
+ber_sock_write(struct ber *ber, const void *buf, size_t len)
+{
+	const unsigned char *p = buf;
+	size_t done = 0;
+	ssize_t w;
+
+	while (done < len) {
+		if (ber->br_tls != NULL) {
+			w = tls_write(ber->br_tls, p + done, len - done);
+			if (w == TLS_WANT_POLLIN || w == TLS_WANT_POLLOUT)
+				continue;
+			if (w == -1) {
+				errno = EIO;
+				return -1;
+			}
+		} else {
+			w = write(ber->fd, p + done, len - done);
+			if (w == -1) {
+				if (errno == EINTR)
+					continue;
+				return -1;
+			}
+		}
+		done += w;
+	}
+	return len;
 }
