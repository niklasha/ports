+/*
+ * Start TLS on the (blocking) connection and complete the handshake,
+ * which verifies the server certificate and name according to cfg.
+ * On failure the connection must not be used any more: the caller is
+ * expected to aldap_close() it, there is no fallback to plain text.
+ */
 int
+aldap_tls(struct aldap *ldap, struct tls_config *cfg, const char *name)
+{
+	int ret;
+
+	if ((ldap->tls = tls_client()) == NULL) {
+		ldap->err = ALDAP_ERR_OPERATION_FAILED;
+		return (-1);
+	}
+	if (tls_configure(ldap->tls, cfg) == -1) {
+		ldap->err = ALDAP_ERR_TLS_ERROR;
+		return (-1);
+	}
+	if (tls_connect_socket(ldap->tls, ldap->ber.fd, name) == -1) {
+		ldap->err = ALDAP_ERR_TLS_ERROR;
+		return (-1);
+	}
+	do {
+		ret = tls_handshake(ldap->tls);
+	} while (ret == TLS_WANT_POLLIN || ret == TLS_WANT_POLLOUT);
+	if (ret == -1) {
+		ldap->err = ALDAP_ERR_TLS_ERROR;
+		return (-1);
+	}
+
+	ldap->ber.br_tls = ldap->tls;
+	return (0);
+}
+
+int
+aldap_req_starttls(struct aldap *ldap)
+{
+	struct ber_element *root = NULL, *elm;
+	int error;
+
+	if ((root = ber_add_sequence(NULL)) == NULL)
+		goto fail;
+
+	elm = ber_printf_elements(root, "d{tst", ++ldap->msgid, BER_CLASS_APP,
+	    (unsigned long)LDAP_REQ_EXTENDED, LDAP_STARTTLS_OID,
+	    BER_CLASS_CONTEXT, (unsigned long)0);
+	if (elm == NULL)
+		goto fail;
+
+	LDAP_DEBUG("aldap_req_starttls", root);
+
+	error = ber_write_elements(&ldap->ber, root);
+	ber_free_elements(root);
+	root = NULL;
+	if (error == -1)
+		goto fail;
+
+	return (ldap->msgid);
+fail:
+	if (root != NULL)
+		ber_free_elements(root);
+
+	ldap->err = ALDAP_ERR_OPERATION_FAILED;
+	return (-1);
+}
