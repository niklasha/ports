+/*
+ * Ask the server to switch the connection to TLS (RFC 4511 4.14).
+ */
+static int
+ldap_starttls(struct aldap *ldap)
+{
+	struct aldap_message	*amsg;
+	int			 ok;
+
+	if (aldap_req_starttls(ldap) == -1) {
+		log_warnx("warn: table-ldap: failed to send StartTLS request");
+		return 0;
+	}
+	if ((amsg = aldap_parse(ldap)) == NULL) {
+		log_warnx("warn: table-ldap: no StartTLS response");
+		return 0;
+	}
+	ok = amsg->message_type == LDAP_RES_EXTENDED &&
+	    aldap_get_resultcode(amsg) == LDAP_SUCCESS;
+	if (!ok)
+		log_warnx("warn: table-ldap: server refused StartTLS, "
+		    "result #%d", aldap_get_resultcode(amsg));
+	aldap_freemsg(amsg);
+	return ok;
+}
+
+/*
+ * Set up TLS on a freshly connected socket: ldaps:// starts with the
+ * handshake, ldap+tls:// does StartTLS first.  The server certificate
+ * is verified against the system CA bundle (or ca_file) and must match
+ * the host name from the URL.  Any failure fails the whole connection;
+ * we never fall back to plain text.
+ */
+static int
+ldap_start_tls(struct aldap *ldap, const struct aldap_url *lu)
+{
+	struct tls_config	*tls_config;
+	const char		*errstr;
+	int			 ret = 0;
+
+	if (lu->protocol == LDAPTLS && !ldap_starttls(ldap))
+		return 0;
+
+	if ((tls_config = tls_config_new()) == NULL) {
+		log_warnx("warn: table-ldap: tls_config_new failed");
+		return 0;
+	}
+	if (ca_file != NULL &&
+	    tls_config_set_ca_file(tls_config, ca_file) == -1) {
+		log_warnx("warn: table-ldap: can't load ca_file %s: %s",
+		    ca_file, tls_config_error(tls_config));
+		goto out;
+	}
+	if (aldap_tls(ldap, tls_config, lu->host) == -1) {
+		aldap_get_errno(ldap, &errstr);
+		log_warnx("warn: table-ldap: TLS with %s:%s failed: %s",
+		    lu->host, lu->port, errstr);
+		goto out;
+	}
+	log_debug("debug: table-ldap: TLS %s with %s:%s established",
+	    tls_conn_version(ldap->tls), lu->host, lu->port);
+	ret = 1;
+out:
+	tls_config_free(tls_config);
+	return ret;
+}
