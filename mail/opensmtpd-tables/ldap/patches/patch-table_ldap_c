+/*
+ * Run a query, reconnecting once if the connection is gone or the
+ * query fails.  A failed reconnect leaves aldap NULL, so never touch
+ * the connection before checking it: the next request will simply try
+ * to reconnect again instead of crashing.
+ */
 static int
-table_ldap_lookup(int service, struct dict *params, const char *key, char *dst, size_t sz)
+ldap_run_query_reconnect(int type, const char *key, char *dst, size_t sz)
 {
 	int ret;
 
+	if (aldap != NULL &&
+	    (ret = ldap_run_query(type, key, dst, sz)) >= 0)
+		return ret;
+	log_debug("debug: table-ldap: reconnecting");
+	if (!ldap_open()) {
+		log_warnx("warn: table-ldap: failed to connect");
+		return -1;
+	}
+	return ldap_run_query(type, key, dst, sz);
+}
